{
    "name": "uams-web/uamswp-acfcdt-migrator",
    "description": "Moves ACF values out of ACF Custom Database Tables into core postmeta with snapshot, verify and rollback.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/acf-pro-stubs": "^6.8",
        "php-stubs/wordpress-stubs": "^6.8",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "pint": "pint",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "test": "@test:unit",
        "test:pint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "test:unit": "pest"
    },
    "scripts-descriptions": {
        "pint": "Format the PHP files with Pint.",
        "refactor": "Apply Rector's gating profile.",
        "refactor:sweep": "Apply Rector's sweep profile (run deliberately, review the diff).",
        "stan": "Run PHPStan at the configured level.",
        "test": "Run the test suite.",
        "test:pint": "Check formatting with Pint without changing files.",
        "test:refactor": "Preview Rector's gating profile.",
        "test:refactor:sweep": "Preview Rector's sweep profile.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database."
    }
}
